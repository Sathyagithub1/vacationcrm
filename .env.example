# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/holiday_delight_crm"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
NEXTAUTH_SECRET="your-secret-key-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Super Admin (first-time setup)
SUPER_ADMIN_EMAIL="admin@holidaydelight.com"
SUPER_ADMIN_PASSWORD="change-me-immediately"

# SMTP
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# SMS Gateway
SMS_API_KEY=""
SMS_API_URL=""

# WhatsApp
WHATSAPP_API_KEY=""
WHATSAPP_API_URL=""

# Backup
BACKUP_CRON="0 2 * * *"

# AI Provider Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your_64_hex_char_encryption_key_here

# Tenant credential encryption key — used by src/lib/crypto/credential-encryption.ts
# to encrypt razorpayKeySecret, razorpayWebhookSecret, telephonyApiSecret,
# sttApiKey, and ttsApiKey at rest.  Must be a 32-byte (64 hex char) key.
# Generate: openssl rand -hex 32
#       OR: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED in production — leave blank to disable encryption (dev only).
CREDENTIAL_ENCRYPTION_KEY=

# Phase 6a — gate the new intake pipeline per tenant (comma-separated tenant IDs, or '*' for all)
INTAKE_PIPELINE_V2_ENABLED=

# ─── Multi-tenant SaaS (all DEFAULT-OFF — leave unset for the current
#     single-tenant production behavior) ─────────────────────────────────────

# Public self-service tenant signup via POST /api/tenants and the /signup page.
# Unset or anything != "true"  → signup is CLOSED (POST returns 403, /signup
#   shows "Signups are currently closed"). This is the default; the live app is
#   untouched. Set to "true" to open public signup.
SIGNUP_ENABLED=
# Client-visible mirror of the flag (read by the /signup page in the browser).
# Keep in sync with SIGNUP_ENABLED. Unset → the form is not rendered.
NEXT_PUBLIC_SIGNUP_ENABLED=

# Host-based (subdomain / custom-domain) tenant resolution middleware.
# Unset or != "true" → middleware is a COMPLETE NO-OP (identical to having no
#   middleware, which was the prior state). Authenticated tenant scoping ALWAYS
#   comes from the NextAuth session JWT regardless of this flag; when on, the
#   middleware only attaches advisory x-tenant-id / x-tenant-slug request
#   headers resolved from the Host header.
MULTI_TENANT_SUBDOMAINS=
# Base domain used to derive a subdomain slug when MULTI_TENANT_SUBDOMAINS=true,
# e.g. "example.com" so "acme.example.com" resolves the "acme" tenant.
MULTI_TENANT_BASE_DOMAIN=

# Billing (Stripe). Unset → billing is DISABLED: no enforcement, no charges,
#   every tenant is treated as active/free, and the Stripe SDK is never loaded.
#   Set to enable createCheckoutSession() (see src/lib/billing.ts). The `stripe`
#   npm package is optionally lazy-required only when this is set.
STRIPE_SECRET_KEY=
